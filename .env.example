# Copia este archivo como .env.local y rellena lo que quieras activar.
# Sin ninguna variable, FORMA AI funciona en modo local con datos de demostración.

# ── Base de datos y autenticación (Firebase) ─────────────────────────────
# Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Inteligencia artificial (solo servidor, nunca llega al navegador) ─────
# Opción A · Claude (Anthropic) — recomendado para analizar fotos
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Opción B · Gemini (Google AI Studio)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Forzar proveedor: anthropic | gemini | demo  (por defecto: el primero con clave)
# AI_PROVIDER=
